# Copy this file to .env.local and adjust for your machine.
#   cp .env.example .env.local

# Ollama connection
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model roles (see docs/01_仕様書.md section 5 / docs/03_実行計画書.md phase 0)
# chat    = response generation (user-facing answers)   -- a "smarter" model
# summary = compressing old conversation history        -- see the block below
# embed   = vectorization for RAG search & store        -- embedding model
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=bge-m3

# Context length for the chat model, passed as options.num_ctx by the app.
#
# Measure rather than guess, and measure the way the app actually runs.
#
# For hybrid models like qwen3.5 the KV cache is far smaller than the usual rule
# of thumb suggests (most layers are SSM, not attention), and decode speed vs
# num_ctx is NOT monotonic - on the reference machine (8GB RX Vega, Vulkan) 8192
# ran at half the speed of 12288 even though both kept every layer on the GPU.
#
# More important: benchmark the chat model WITH THE EMBEDDING MODEL RESIDENT.
# The app embeds every question, so they share the GPU in real use, and on the
# reference machine there is a cliff in combined residency (6.47GB fine, 6.50GB
# not) where decode loses ~55% - silently, with all layers still reported on the
# GPU and nothing in the log. Benchmarking the chat model alone picks a value
# that looks great and is half speed in production.
#
# What to check when tuning: `offloaded N/M layers to GPU` in Ollama's server
# log, then a real multi-turn run with embedding and compaction in the loop.
OLLAMA_CHAT_NUM_CTX=12288

# Tokens reserved for the answer (options.num_predict). Without this the reply
# is whatever is left of num_ctx after the prompt, so replies shrink as the
# conversation grows and eventually stop mid-sentence. The app builds prompts
# against num_ctx minus this minus the safety margin.
OLLAMA_CHAT_MAX_OUTPUT_TOKENS=2048
# Slack for chat-template markup and tokeniser drift.
OLLAMA_CHAT_PROMPT_SAFETY_TOKENS=192

# Reasoning models (e.g. qwen3.5) can waste the whole budget on <think> and
# return an empty answer. Set true only if your chat model benefits from it.
OLLAMA_CHAT_THINK=false

# Summary / fact-extraction model (phase 4 compression).
#
# Default is the SAME model as chat, on purpose. A small dedicated model is
# faster per token, but if it cannot be resident alongside the chat model, every
# compaction evicts the chat model and the next turn reloads it. On the
# reference machine that swap cost 19.1s per compaction turn - more than the
# small model ever saved. Only point this at a smaller model if you have the
# VRAM for both, or if compaction is rare in your usage.
OLLAMA_SUMMARY_MODEL=qwen3.5:9b
# Ignored while OLLAMA_SUMMARY_MODEL == OLLAMA_CHAT_MODEL: the code pins the two
# to one context length, because Ollama reloads a model whose num_ctx changed.
OLLAMA_SUMMARY_NUM_CTX=4096
OLLAMA_SUMMARY_MAX_OUTPUT_TOKENS=768

# Phase 4 auto-compression thresholds. The trigger counts the verbatim history
# *and* the rolling summary, since both are sent with every prompt. Keep it well
# under the prompt budget (num_ctx - output reserve - safety), but not so far
# under that compaction fires every single turn: it should sit above what a
# compaction leaves behind (CONVO_KEEP_RECENT_TURNS * 2 messages) plus one turn.
CONVO_COMPRESS_TRIGGER_TOKENS=6000
CONVO_KEEP_RECENT_TURNS=4
# Ceiling on the rolling summary. Defaults to 30% of the prompt budget.
# CONVO_MAX_SUMMARY_TOKENS=

# Shared password gate (phase 6). Empty = auth disabled (fine for pure localhost
# dev). Set a real value before exposing the app over Tailscale.
APP_PASSWORD=

# Optional overrides for the admin restart action (phase 5).
# OLLAMA_RESTART_CMD=
# OLLAMA_BIN=
